-        float2(texture_coordinate_info.position.x, texture_coordinate_info.position.y),
-        s_wrap_native,
-        t_wrap_native,
-        float2(0.0, 1.0), 
-        float2(0.0, 1.0));
-
-    if (tangent_space_flip_r_channel)
