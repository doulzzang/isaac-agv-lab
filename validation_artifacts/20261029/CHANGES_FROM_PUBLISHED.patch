+    float coat_roughness_2 = coat_roughness * coat_roughness;
+    float2 coat_roughness_anisotropy = 
+        coat_anisotropy != 0.0f ?
+            OmniShared::compute_anisotropy(coat_roughness_2, coat_anisotropy):
+            float2(coat_roughness_2);
