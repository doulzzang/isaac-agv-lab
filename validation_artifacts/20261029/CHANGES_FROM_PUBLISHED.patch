-    float3 transformed_tangent_u = texture_coordinate_info.tangent_u;
-    float3 transformed_tangent_v = texture_coordinate_info.tangent_v;
-
-    if (local_s_flip)
-        transformed_tangent_u = -transformed_tangent_u;
