+        anno::in_group("Base"),
+        anno::hard_range(0.0f, 1.0f)
+    ]],
+
+    //Metalness
+    //
+    float metalness = float(0.0) [[ 
+        anno::display_name("Metalness"),
+        anno::in_group("Base"),
+        anno::hard_range(0.0f, 1.0f)
+    ]],
+
+    //Specular reflection
+    //
+    float specular_reflection_weight = float(1.0) [[ 
