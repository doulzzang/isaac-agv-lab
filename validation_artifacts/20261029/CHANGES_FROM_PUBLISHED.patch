-
-    if (tangent_space_flip_b_channel)
-        result.z = 1.0f - result.z;
-
-    result = (result - float3(0.5)) * (2.0f * tangent_space_factor);
-
-    return texture_lookup_data(
-        color(0.0),
-        0.0f,
-        math::normalize(
-            transformed_tangent_u * result.x +
-            transformed_tangent_v * result.y +
