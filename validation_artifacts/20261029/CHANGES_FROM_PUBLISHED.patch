+[[  
+    anno::display_name("OmniSurfaceBase"),
+    anno::description("A base material for modeling a variety of surfaces."),
+    anno::author("NVIDIA Corporation"),
+    anno::key_words(string[]("generic", "surface")),
+    anno::version(1, 0, 0, ""),
+    anno::modified(2020, 11, 28, "")
