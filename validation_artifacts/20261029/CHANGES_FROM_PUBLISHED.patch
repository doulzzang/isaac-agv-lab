+
+export texture_lookup_data texture_adjustment(
+    texture_lookup_data texture_data,
+    float exposure = 0.0f,
+    color default_color = color(0.5),
+    color color_gain = color(1.0),
+    color color_offset = color(0.0),
+    float alpha_gain = 1.0f,
