-
-        case wrap_black:
-            s_wrap_native = tex::wrap_clip;
-            break;
-
-        case wrap_clamp:
-            s_wrap_native = tex::wrap_clamp;
-            break;
-
-        case wrap_mirror:
-            s_wrap_native = tex::wrap_mirrored_repeat;
